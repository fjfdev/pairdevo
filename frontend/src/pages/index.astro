---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar';
import HeroAnimation from '../components/HeroAnimation';
---

<Base
  title="pairdevo — Free Real-Time Code Sharing & Collaborative Editor"
  description="Share code online for free with real-time collaboration. No account, no setup — create a project, write code with syntax highlighting for 12+ languages, and share the link. Try pairdevo free."
>
  <Navbar client:load />

  <!-- Hero -->
  <section class="relative overflow-hidden grid-bg min-h-[calc(100vh-56px)] flex items-center">
    <!-- Ambient glows -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-neon-cyan)] opacity-5 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-[var(--color-neon-purple)] opacity-5 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Left: copy -->
        <div class="space-y-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--color-neon-green)]/30 bg-[var(--color-neon-green)]/5">
            <span class="w-2 h-2 rounded-full bg-[var(--color-neon-green)] animate-pulse"></span>
            <span class="text-xs font-mono text-[var(--color-neon-green)]">free · no account required</span>
          </div>

          <div class="space-y-4">
            <h1 class="text-5xl lg:text-6xl font-bold leading-tight tracking-tight">
              Share code<br />
              <span class="text-[var(--color-neon-cyan)] text-glow-cyan">in real time</span><br />
              <span class="text-[var(--color-neon-green)]">for free</span>
            </h1>
            <p class="text-lg text-[var(--color-text-secondary)] max-w-md leading-relaxed">
              The free collaborative code editor. Create a project, write code with
              syntax highlighting for 12+ languages, and share the link — collaborators
              join instantly with zero setup, no login needed.
            </p>
          </div>

          <div class="flex flex-wrap gap-4">
            <a
              href="/dashboard"
              class="px-6 py-3 rounded-lg bg-[var(--color-neon-cyan)] text-[var(--color-bg-base)] font-semibold font-mono
                     hover:opacity-90 transition-all duration-200 glow-cyan text-sm"
            >
              start sharing for free →
            </a>
            <a
              href="#features"
              class="px-6 py-3 rounded-lg border border-[var(--color-border-bright)] text-[var(--color-text-secondary)]
                     hover:border-[var(--color-neon-cyan)] hover:text-[var(--color-neon-cyan)] transition-all duration-200 text-sm font-mono"
            >
              learn more
            </a>
          </div>

          <!-- Stats row -->
          <div class="flex gap-8 pt-4 border-t border-[var(--color-border)]">
            <div>
              <div class="text-2xl font-bold font-mono text-[var(--color-neon-green)]">free</div>
              <div class="text-xs text-[var(--color-text-muted)] font-mono">always & forever</div>
            </div>
            <div>
              <div class="text-2xl font-bold font-mono text-[var(--color-neon-purple)]">24h</div>
              <div class="text-xs text-[var(--color-text-muted)] font-mono">auto-expiry</div>
            </div>
            <div>
              <div class="text-2xl font-bold font-mono text-[var(--color-neon-cyan)]">12+</div>
              <div class="text-xs text-[var(--color-text-muted)] font-mono">languages</div>
            </div>
            <div>
              <div class="text-2xl font-bold font-mono text-[var(--color-neon-pink)]">∞</div>
              <div class="text-xs text-[var(--color-text-muted)] font-mono">collaborators</div>
            </div>
          </div>
        </div>

        <!-- Right: animated code demo -->
        <div class="relative">
          <!-- Window chrome -->
          <div class="rounded-xl border border-[var(--color-border-bright)] bg-[var(--color-bg-surface)] overflow-hidden glow-cyan">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-bg-muted)]">
              <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
              <span class="ml-4 text-xs font-mono text-[var(--color-text-muted)]">share.ts</span>
              <span class="ml-auto text-xs font-mono text-[var(--color-neon-green)] flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-neon-green)] animate-pulse"></span>
                2 connected
              </span>
            </div>
            <!-- Line numbers + code -->
            <div class="p-4 flex gap-4">
              <div class="text-[var(--color-text-muted)] font-mono text-sm leading-6 select-none text-right">
                {[1,2,3,4,5,6,7,8].map(n => <div>{n}</div>)}
              </div>
              <div class="flex-1 min-w-0">
                <HeroAnimation client:load />
              </div>
            </div>
          </div>
          <!-- Share link pill below the card -->
          <div class="mt-4 flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[var(--color-neon-purple)]/40 bg-[var(--color-bg-elevated)]">
            <svg class="w-4 h-4 text-[var(--color-neon-purple)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/>
            </svg>
            <span class="font-mono text-sm text-[var(--color-text-secondary)] truncate">
              pairdevo.com/<span class="text-[var(--color-neon-purple)]">xK9mP2nR4w</span>
            </span>
            <button class="ml-auto text-xs font-mono text-[var(--color-neon-purple)] hover:opacity-70 transition-opacity shrink-0">
              copy
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 border-t border-[var(--color-border)] bg-[var(--color-bg-surface)]/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold font-mono mb-12">
        share code online in <span class="text-[var(--color-neon-cyan)]">3 steps</span>
      </h2>
      <div class="grid sm:grid-cols-3 gap-8">
        {[
          { step: '01', title: 'Create a project', desc: 'Pick a name and a language. Your free code editor opens instantly — no sign-up, no waiting.' },
          { step: '02', title: 'Write or paste code', desc: 'Use the Monaco editor (the same engine powering VS Code) with full syntax highlighting.' },
          { step: '03', title: 'Share the link', desc: 'Copy the URL and send it. Anyone who opens it sees your code live in real time.' },
        ].map(({ step, title, desc }) => (
          <div class="space-y-3 text-left sm:text-center">
            <div class="font-mono text-4xl font-bold text-[var(--color-neon-purple)] opacity-40">{step}</div>
            <h3 class="font-mono font-semibold text-[var(--color-text-primary)]">{title}</h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-24 border-t border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-16">
        <h2 class="text-3xl font-bold font-mono">
          everything you need to <span class="text-[var(--color-neon-cyan)]">collaborate</span>
        </h2>
        <p class="text-[var(--color-text-secondary)] max-w-xl mx-auto">
          A free online code sharing tool built for developers. No setup, no account, no cost.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '⚡', title: 'Real-time collaboration', desc: 'Every keystroke is broadcast instantly to all collaborators via WebSockets — truly live code sharing.', color: 'var(--color-neon-yellow)' },
          { icon: '🎨', title: 'Syntax highlighting', desc: 'Monaco Editor (the engine behind VS Code) with support for 12+ languages including TypeScript, Python, Rust, Go, and more.', color: 'var(--color-neon-cyan)' },
          { icon: '🔗', title: 'Instant share link', desc: 'One click copies a shareable URL. Anyone with the link can view and edit your code — no account needed.', color: 'var(--color-neon-purple)' },
          { icon: '🆓', title: '100% free', desc: 'pairdevo is completely free to use. No plans, no paywalls, no credit card — free real-time code sharing for everyone.', color: 'var(--color-neon-green)' },
          { icon: '⏳', title: '24h auto-expiry', desc: 'Shared code snippets automatically delete after 24 hours — no clutter, no stale data, full privacy.', color: 'var(--color-neon-pink)' },
          { icon: '🌙', title: 'Zero friction', desc: 'No account, no install, no config. Open the link and start collaborating in seconds.', color: 'var(--color-neon-yellow)' },
        ].map(({ icon, title, desc, color }) => (
          <div class="p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-surface)] hover:border-[var(--color-border-bright)] transition-colors">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-mono font-semibold mb-2" style={`color: ${color}`}>{title}</h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ — great for long-tail search queries -->
  <section id="faq" class="py-24 border-t border-[var(--color-border)] bg-[var(--color-bg-surface)]/40">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold font-mono">
          frequently asked <span class="text-[var(--color-neon-purple)]">questions</span>
        </h2>
      </div>

      <dl class="space-y-6">
        {[
          {
            q: 'Is pairdevo free?',
            a: 'Yes — pairdevo is completely free. There are no paid plans, no usage limits beyond 5 active projects per session, and no credit card required. You can share code in real time at no cost.',
          },
          {
            q: 'Do I need to create an account to share code?',
            a: 'No. pairdevo requires zero sign-up. Open the site, create a project, and share the link. Your collaborators can join without an account too.',
          },
          {
            q: 'How does real-time code collaboration work?',
            a: 'When you open a shared project link, your browser connects to a WebSocket server. Every change you make in the editor is broadcast live to everyone else viewing the same link — similar to Google Docs but for code.',
          },
          {
            q: 'What programming languages are supported?',
            a: 'pairdevo supports TypeScript, JavaScript, Python, Rust, Go, C++, Java, HTML, CSS, JSON, SQL, and Markdown — with full syntax highlighting powered by Monaco Editor.',
          },
          {
            q: 'How long do shared code projects last?',
            a: 'Each project expires automatically after 24 hours. This keeps things clean and ensures your snippets don\'t hang around longer than needed.',
          },
          {
            q: 'How many people can collaborate at the same time?',
            a: 'There is no hard limit on collaborators per project. Anyone with the link can join and edit in real time simultaneously.',
          },
          {
            q: 'Is pairdevo a good alternative to Pastebin or GitHub Gist?',
            a: 'If you need live collaboration, yes. Unlike Pastebin or GitHub Gist, pairdevo lets multiple people edit the same code simultaneously in real time without any account. It\'s ideal for pair programming, interviews, or quick debugging sessions.',
          },
        ].map(({ q, a }) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
            <dt class="font-mono font-semibold text-[var(--color-text-primary)] mb-3">{q}</dt>
            <dd class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 border-t border-[var(--color-border)]">
    <div class="max-w-2xl mx-auto px-4 text-center space-y-8">
      <h2 class="text-4xl font-bold font-mono">
        ready to <span class="text-[var(--color-neon-green)] text-glow-green">start?</span>
      </h2>
      <p class="text-[var(--color-text-secondary)]">
        Free real-time code sharing — no sign-up, no setup, no cost.
      </p>
      <a
        href="/dashboard"
        class="inline-block px-8 py-4 rounded-lg bg-[var(--color-neon-green)] text-[var(--color-bg-base)] font-bold font-mono glow-green hover:opacity-90 transition-all duration-200"
      >
        create a free project →
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-[var(--color-border)] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="font-mono text-sm text-[var(--color-text-muted)]">
        pair<span class="text-[var(--color-neon-cyan)]">devo</span>
        <span class="ml-2 opacity-50">— free real-time code sharing</span>
      </span>
      <nav class="flex items-center gap-6" aria-label="Footer">
        <a href="#features" class="font-mono text-xs text-[var(--color-text-muted)] hover:text-[var(--color-neon-cyan)] transition-colors">features</a>
        <a href="#faq" class="font-mono text-xs text-[var(--color-text-muted)] hover:text-[var(--color-neon-cyan)] transition-colors">faq</a>
        <a href="/dashboard" class="font-mono text-xs text-[var(--color-text-muted)] hover:text-[var(--color-neon-cyan)] transition-colors">dashboard</a>
      </nav>
      <span class="font-mono text-xs text-[var(--color-text-muted)]">
        projects expire after 24h
      </span>
    </div>
  </footer>
</Base>
